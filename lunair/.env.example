# Postgres, z. B. Neon (pooled connection string). Auf Vercel setzt die Neon-Integration das selbst.
DATABASE_URL=postgres://user:password@localhost:5432/lunair

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Lokal und auf lunair-*.vercel.app nicht nötig, nur für eine eigene Domain.
# BETTER_AUTH_URL=https://lunair.example.de
